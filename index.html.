<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><meta name="theme-color" content="#07111f"><title>Crash 1000 Tick Counter</title>
<style>
:root{color-scheme:dark;--bg:#07111f;--panel:#101d2e;--line:#27384d;--text:#eef5ff;--muted:#9aabc0;--cyan:#47d7c8;--red:#ff6575;--gold:#f6c65b}*{box-sizing:border-box}body{margin:0;background:radial-gradient(ellipse at 50% -15%,#1d3b58 0,transparent 55%),var(--bg);color:var(--text);font:16px system-ui,-apple-system,Segoe UI,sans-serif;min-height:100vh;padding:env(safe-area-inset-top) 16px env(safe-area-inset-bottom)}main{width:min(100%,520px);margin:0 auto;padding:22px 0 30px}.top{display:flex;justify-content:space-between;align-items:center;margin-bottom:20px}.brand{font-weight:750;letter-spacing:.02em}.badge{color:var(--cyan);font-size:12px;border:1px solid #28665f;border-radius:99px;padding:6px 10px}.panel{background:linear-gradient(160deg,#13243a,#0d1928);border:1px solid var(--line);border-radius:22px;padding:20px;margin:14px 0;box-shadow:0 12px 40px #0003}.label{color:var(--muted);font-size:13px;text-transform:uppercase;letter-spacing:.11em}.count{font-size:clamp(58px,18vw,92px);font-weight:800;line-height:1;margin:9px 0 12px;font-variant-numeric:tabular-nums}.sub{color:var(--muted);font-size:14px}.progress{height:10px;background:#25344a;border-radius:99px;overflow:hidden;margin:18px 0 8px}.bar{height:100%;width:0;background:linear-gradient(90deg,var(--cyan),#91f5cf);border-radius:99px;transition:width .2s}.row{display:flex;gap:10px;margin-top:16px}.row button,.connect{border:0;border-radius:13px;padding:14px 16px;font-size:15px;font-weight:700;cursor:pointer}.row button{flex:1;background:#203149;color:var(--text)}.row .primary{background:var(--cyan);color:#06201d}.connect{width:100%;background:var(--cyan);color:#06201d;margin-top:12px}.status{display:flex;align-items:center;gap:8px;color:var(--muted);font-size:14px}.dot{width:9px;height:9px;border-radius:50%;background:#75849a}.dot.on{background:var(--cyan);box-shadow:0 0 10px var(--cyan)}input{width:100%;background:#091522;color:var(--text);border:1px solid var(--line);padding:13px;border-radius:12px;font-size:16px;margin-top:8px}.hint{font-size:13px;color:var(--muted);line-height:1.5}.warn{border-left:3px solid var(--gold);padding-left:12px}.price{font-size:28px;font-weight:700;font-variant-numeric:tabular-nums;margin-top:6px}.hidden{display:none!important}footer{text-align:center;color:#75849a;font-size:12px;padding:10px 16px 24px}
</style></head><body><main>
<div class="top"><div class="brand">CRASH 1000 <span style="color:var(--cyan)">TICKER</span></div><div class="badge">LIVE TICK COUNTER</div></div>
<section class="panel"><div class="label">Ticks counted this session</div><div class="count" id="count">0</div><div class="status"><span class="dot" id="dot"></span><span id="status">Not connected</span></div><div class="progress"><div class="bar" id="bar"></div></div><div class="sub"><span id="left">1,000</span> ticks to the 1,000-tick reference mark</div><div class="row"><button class="primary" id="reset">Reset count</button><button id="pause" disabled>Pause</button></div></section>
<section class="panel"><div class="label">Latest price</div><div class="price" id="price">—</div><div class="sub" id="updated">Waiting for connection</div><button class="connect" id="connect">Connect to Deriv price feed</button><div class="row"><button id="manual">Count 1 tick manually</button></div></section>
<section class="panel"><div class="label">Connection settings</div><label for="symbol" class="hint">Deriv symbol</label><input id="symbol" value="CRASH1000" autocomplete="off" spellcheck="false"><p class="hint">The app subscribes to public tick prices; it does not access your account or place trades. If the symbol is not accepted, check its exact spelling in your Deriv market list.</p></section>
<section class="panel warn"><div class="label" style="color:var(--gold)">Remember</div><p class="hint">1,000 ticks is a long-run average, not a countdown. This counter cannot predict when a drop will happen. Price spikes can arrive at any tick.</p></section>
</main><footer>Connection requires internet. Keep this page open while counting.</footer>
<script>
(()=>{let n=0,ws=null,paused=false,lastQuote=null;const $=id=>document.getElementById(id);function show(){ $('count').textContent=n.toLocaleString();$('left').textContent=(1000-(n%1000)||1000).toLocaleString();$('bar').style.width=(n%1000/10)+'%';}function tick(q){if(paused)return;if(lastQuote!==q){n++;lastQuote=q;show()}$('price').textContent=q;$('updated').textContent='Last price update: '+new Date().toLocaleTimeString()}function disconnect(msg){$('dot').classList.remove('on');$('status').textContent=msg;$('connect').disabled=false;$('connect').textContent='Reconnect to Deriv price feed';$('pause').disabled=true;ws=null}function connect(){if(ws){ws.close();ws=null}const sym=$('symbol').value.trim().toUpperCase();if(!sym){$('status').textContent='Enter a symbol';return} $('connect').disabled=true;$('status').textContent='Connecting…';try{ws=new WebSocket('wss://ws.derivws.com/websockets/v3?app_id=1089');ws.onopen=()=>ws.send(JSON.stringify({ticks:sym,subscribe:1}));ws.onmessage=e=>{const d=JSON.parse(e.data);if(d.error){disconnect('Feed error: '+d.error.message);return}if(d.msg_type==='tick'){ $('dot').classList.add('on');$('status').textContent='Connected · '+sym;$('connect').textContent='Disconnect';$('connect').disabled=false;$('pause').disabled=false;tick(d.tick.quote)}};ws.onerror=()=>disconnect('Connection error');ws.onclose=()=>{if(ws)disconnect('Disconnected')}}catch(e){disconnect('Could not connect')}}$('connect').onclick=()=>ws?(ws.close(),disconnect('Disconnected')):connect();$('reset').onclick=()=>{n=0;lastQuote=null;show()};$('pause').onclick=()=>{paused=!paused;$('pause').textContent=paused?'Resume':'Pause';$('status').textContent=paused?'Paused · ticks ignored':'Connected · '+$('symbol').value.trim().toUpperCase()};$('manual').onclick=()=>{n++;show()};show()})();
</script></body></html>
